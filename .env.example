# Lambda Function URL of the MCP server, ending in /mcp
mcp_url=https://<your-function-url-id>.lambda-url.us-east-1.on.aws/mcp

# Secrets Manager secret holding {"api_key": "..."}
secrets_id=<your-secret-name>
aws_region=us-east-1

# Optional
# MLFLOW_TRACKING_URI=http://127.0.0.1:5000
# MLFLOW_EXPERIMENT=geopolitical-agent
